<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AskBofah.Views.ChatView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AskBofah.Models"
    xmlns:vm="clr-namespace:AskBofah.ViewModels"
    x:Name="ChatRoot"
    x:DataType="vm:ChatViewModel"
    BackgroundColor="{StaticResource WorkspaceBackground}">

    <Grid ColumnDefinitions="260,*">

        <!-- ============================================================ -->
        <!-- SIDEBAR                                                       -->
        <!-- ============================================================ -->
        <Border
            Grid.Column="0"
            BackgroundColor="{StaticResource SidebarBackground}"
            Stroke="{StaticResource SidebarBorder}"
            StrokeThickness="1"
            Padding="10,14,10,10">

            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">

                <!-- Brand -->
                <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="6,4,6,10">
                    <Border
                        WidthRequest="32" HeightRequest="32"
                        Background="{StaticResource BrandGradient}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="✦" FontSize="16" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Ask Bofah" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- 1. New Chat -->
                <Border
                    Grid.Row="1"
                    BackgroundColor="{StaticResource NewChatBackground}"
                    Stroke="{StaticResource SidebarBorder}"
                    StrokeThickness="1"
                    Padding="4"
                    Margin="4,0,4,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Button
                        Text="＋   New chat"
                        Command="{Binding NewChatCommand}"
                        Style="{StaticResource SidebarButton}"
                        HorizontalOptions="Fill" />
                </Border>

                <!-- 2. Chat History -->
                <ScrollView Grid.Row="2" Margin="4,4,4,4">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="CHAT HISTORY"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.2"
                            TextColor="{StaticResource TextMuted}"
                            Margin="12,8,8,6" />

                        <ActivityIndicator
                            IsVisible="{Binding IsLoadingHistory}"
                            IsRunning="{Binding IsLoadingHistory}"
                            Color="{StaticResource BrandTeal}"
                            HeightRequest="20" />

                        <CollectionView ItemsSource="{Binding Conversations}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label
                                    Text="No chats yet"
                                    FontSize="11"
                                    TextColor="{StaticResource TextMuted}"
                                    Margin="12,6"
                                    HorizontalOptions="Start" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConversationSummary">
                                    <Grid Padding="0,1">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference ChatRoot}, Path=BindingContext.OpenConversationCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" Padding="10,6">
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="12"
                                                TextColor="{StaticResource TextSecondary}"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- 3. Upgrade Plan -->
                <Border
                    Grid.Row="3"
                    Background="{StaticResource BrandGradient}"
                    StrokeThickness="0"
                    Padding="12"
                    Margin="4,4,4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Upgrade" FontSize="13"
                               FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding PlanLabel}" FontSize="10"
                               TextColor="#E6F7F7" LineBreakMode="WordWrap" />
                        <Button
                            Text="Upgrade plan"
                            FontSize="11"
                            HeightRequest="34"
                            BackgroundColor="White"
                            TextColor="{StaticResource BrandTealDark}"
                            CornerRadius="8"
                            Command="{Binding UpgradePlanCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- User Profile + Logout -->
                <Border
                    Grid.Row="4"
                    BackgroundColor="{StaticResource ProfileBackground}"
                    Stroke="{StaticResource SidebarBorder}"
                    StrokeThickness="1"
                    Padding="10,8"
                    Margin="4,6,4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                        <Border
                            Grid.Column="0"
                            WidthRequest="28" HeightRequest="28"
                            BackgroundColor="{StaticResource BrandTeal}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Initial}" FontSize="11"
                                   FontAttributes="Bold" TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding UserName}" FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PlanTier}" FontSize="10"
                                   TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="⏻"
                            FontSize="16"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Danger}"
                            Command="{Binding LogoutCommand}"
                            VerticalOptions="Center" />

                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MESSAGES + COMPOSER                                          -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- Greeting header -->
            <Border Grid.Row="0"
                    BackgroundColor="{StaticResource WorkspaceBackground}"
                    Stroke="{StaticResource HeaderBorder}"
                    StrokeThickness="1"
                    Padding="24,14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Greeting}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Your intelligent workspace"
                           FontSize="11"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Messages -->
            <CollectionView
                x:Name="MessagesView"
                Grid.Row="1"
                ItemsSource="{Binding Messages}"
                SelectionMode="None"
                Margin="30,24">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="22" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="0,2">

                            <!-- USER -->
                            <Border
                                IsVisible="{Binding IsUser}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="720"
                                BackgroundColor="{StaticResource UserBubble}"
                                StrokeThickness="0"
                                Padding="16,13">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Text}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15" LineHeight="1.35"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding TimestampDisplay}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="10" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- ASSISTANT -->
                            <Grid
                                IsVisible="{Binding IsUser, Converter={StaticResource InverseBoolConverter}}"
                                MaximumWidthRequest="760"
                                HorizontalOptions="Start"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Border Grid.Column="0"
                                        WidthRequest="32" HeightRequest="32"
                                        BackgroundColor="{StaticResource AssistantAvatar}"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Label Text="✦" FontSize="15"
                                           TextColor="{StaticResource BrandTeal}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="Ask Bofah" FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Text}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15" LineHeight="1.45"
                                           LineBreakMode="WordWrap" />
                                    <HorizontalStackLayout Spacing="16">
                                        <Button Text="Copy"
                                                Command="{Binding Source={x:Reference ChatRoot}, Path=BindingContext.CopyMessageCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource MessageActionButton}" />
                                        <Button Text="Share"
                                                Command="{Binding Source={x:Reference ChatRoot}, Path=BindingContext.ShareMessageCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource MessageActionButton}" />
                                        <Button Text="Save"
                                                Command="{Binding Source={x:Reference ChatRoot}, Path=BindingContext.DownloadMessageCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource MessageActionButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Composer -->
            <Grid Grid.Row="2" Padding="0,18,0,18"
                  BackgroundColor="{StaticResource WorkspaceBackground}">
                <VerticalStackLayout MaximumWidthRequest="820"
                                     HorizontalOptions="Center" Spacing="8">
                    <Border
                        BackgroundColor="{StaticResource ComposerBackground}"
                        Stroke="{StaticResource ComposerBorder}"
                        StrokeThickness="1"
                        Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="+"
                                    Style="{StaticResource ComposerIconButton}" />
                            <Entry Grid.Column="1"
                                   Text="{Binding InputText}"
                                   Placeholder="Ask anything"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent"
                                   ReturnType="Send"
                                   ReturnCommand="{Binding SendCommand}" />
                            <Button Grid.Column="2" Text="↑"
                                    Style="{StaticResource SendButton}"
                                    Command="{Binding SendCommand}" />
                        </Grid>
                    </Border>

                    <Label Text="Ask Bofah can make mistakes. Check important information."
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
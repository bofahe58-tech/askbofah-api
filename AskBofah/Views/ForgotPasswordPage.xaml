<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AskBofah.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AskBofah.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Background="{StaticResource AuthBackgroundGradient}"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Ellipse
            WidthRequest="550"
            HeightRequest="550"
            Fill="{StaticResource GlowBrush}"
            Opacity="0.08"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="280"
            TranslationY="-280" />

        <ScrollView
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="24,55,24,35"
                Spacing="26"
                VerticalOptions="Center">

                <!-- Brand -->

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="11">

                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        Background="{StaticResource BrandGradient}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 13">

                        <Label
                            Text="A"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <Label
                        Text="ASK BOFAH"
                        Style="{StaticResource AuthBrandName}"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

                <!-- Card -->

                <Border
                    Style="{StaticResource AuthCard}"
                    MaximumWidthRequest="500"
                    HorizontalOptions="Center">

                    <VerticalStackLayout
                        Spacing="20">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="Reset your password"
                                Style="{StaticResource AuthPageTitle}" />

                            <Label
                                Text="Enter your email address and we'll send you a secure link to create a new password."
                                Style="{StaticResource AuthSubtitle}" />

                        </VerticalStackLayout>

                        <!-- Sent state -->

                        <VerticalStackLayout
                            IsVisible="{Binding IsSent}"
                            Spacing="18">

                            <Border
                                Style="{StaticResource SuccessContainer}">

                                <VerticalStackLayout
                                    Spacing="7">

                                    <Label
                                        Text="Reset link sent"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Success}" />

                                    <Label
                                        Text="{Binding SuccessMessage}"
                                        FontSize="13"
                                        TextColor="#A8DCCC" />

                                </VerticalStackLayout>

                            </Border>

                            <Button
                                Text="Send again"
                                Style="{StaticResource GoogleButton}"
                                Command="{Binding ResendCommand}" />

                            <Button
                                Text="Back to sign in"
                                Style="{StaticResource TextLinkButton}"
                                Command="{Binding GoBackCommand}" />

                        </VerticalStackLayout>

                        <!-- Form -->

                        <VerticalStackLayout
                            IsVisible="{Binding IsNotSent}"
                            Spacing="18">

                            <VerticalStackLayout
                                Spacing="0">

                                <Label
                                    Text="EMAIL ADDRESS"
                                    Style="{StaticResource InputLabel}" />

                                <Border
                                    Style="{StaticResource AuthInputBorder}">

                                    <Entry
                                        Text="{Binding Email}"
                                        Placeholder="you@example.com"
                                        Keyboard="Email"
                                        Style="{StaticResource AuthEntry}" />

                                </Border>

                            </VerticalStackLayout>

                            <Border
                                IsVisible="{Binding HasError}"
                                Style="{StaticResource ErrorContainer}">

                                <Label
                                    Text="{Binding ErrorMessage}"
                                    FontSize="13"
                                    TextColor="#FFB0BC" />

                            </Border>

                            <Button
                                Text="{Binding ButtonText}"
                                Style="{StaticResource PrimaryAuthButton}"
                                Command="{Binding SendResetLinkCommand}" />

                            <ActivityIndicator
                                IsVisible="{Binding IsBusy}"
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource BrandTealBright}" />

                            <Button
                                Text="Back to sign in"
                                Style="{StaticResource TextLinkButton}"
                                Command="{Binding GoBackCommand}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>